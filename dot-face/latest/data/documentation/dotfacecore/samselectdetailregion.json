idth or height is 0), any region can be selected. Otherwise,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the selected region should have non-empty intersection with this bounding box. The selected region"},{"type":"text","text":" "},{"type":"text","text":"should lie fully inside the input image."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If there is no region satisfying these conditions - if image width or height is smaller than 200"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"detectedObjectBoundingBox"},{"type":"text","text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200)."}],"type":"paragraph"},{"code":["                                  a bounding box in the format (x, y, width, height)."],"syntax":null,"type":"codeListing"},{"code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."],"syntax":null,"type":"codeListing"}]}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"fragments":[{"kind":"identifier","text":"samSelectDetailRegion"}],"roleHeading":"Function","symbolKind":"func","navigatorTitle":[{"kind":"identifier","text":"samSelectDetailRegion"}],"modules":[{"name":"DotFaceCore"}],"title":"samSelectDetailRegion","externalID":"c:@F@samSelectDetailRegion","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/DotFaceCore\/documentation\/DotFaceCore"]]},"references":{"doc://DotFaceCore/documentation/DotFaceCore/sam_color_image":{"role":"symbol","abstract":[],"url":"\/documentation\/dotfacecore\/sam_color_image","type":"topic","fragments":[{"text":"sam_color_image","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/DotFaceCore\/documentation\/DotFaceCore\/sam_color_image","title":"sam_color_image"},"doc://DotFaceCore/documentation/DotFaceCore":{"role":"collection","kind":"