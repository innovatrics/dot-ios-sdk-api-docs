"If ","type":"text"},{"code":"detectedObjectBoundingBox","type":"codeVoice"},{"text":" is empty (width or height is 0), any region can be selected. Otherwise,","type":"text"},{"text":" ","type":"text"},{"text":"the selected region should have non-empty intersection with this bounding box. The selected region","type":"text"},{"text":" ","type":"text"},{"text":"should lie fully inside the input image.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If there is no region satisfying these conditions - if image width or height is smaller than 200","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"detectedObjectBoundingBox","type":"codeVoice"},{"text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200).","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["                                  a bounding box in the format (x, y, width, height)."],"type":"codeListing"},{"syntax":null,"code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/dotfacecore\/samselectdetailregion"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/DotFaceCore\/documentation\/DotFaceCore"]]},"identifier":{"url":"doc:\/\/DotFaceCore\/documentation\/DotFaceCore\/samSelectDetailRegion","interfaceLanguage":"occ"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://DotFaceCore/documentation/DotFaceCore/sam_color_image":{"kind":"symbol","url":"\/documentation\/dotfacecore\/sam_color_image","identifier":"doc:\/\/DotFaceCore\/documentation\/DotFaceCore\/sam_color_image","type":"topic","role":"symbol","title":"sam_color_image","fragments":[{"text":"sam_color_image","kind":"identifier"}],"abstract":[]},"doc://DotFaceCore/documentation/DotFaceCore/samSelectDetailRegion":{"title