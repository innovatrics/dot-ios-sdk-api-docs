{"hierarchy":{"paths":[["doc:\/\/DotFaceCore\/documentation\/DotFaceCore"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/DotFaceCore\/documentation\/DotFaceCore\/samSelectDetailRegion"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/dotfacecore\/samselectdetailregion"]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["occ"],"tokens":[{"kind":"typeIdentifier","preciseIdentifier":"c:I","text":"int"},{"kind":"text","text":" "},{"kind":"identifier","text":"samSelectDetailRegion"},{"kind":"text","text":"("},{"kind":"keyword","text":"const"},{"text":" ","kind":"text"},{"preciseIdentifier":"c:@S@sam_color_image","text":"SamColorImage","kind":"typeIdentifier","identifier":"doc:\/\/DotFaceCore\/documentation\/DotFaceCore\/sam_color_image"},{"text":" * ","kind":"text"},{"text":"image","kind":"internalParam"},{"text":", ","kind":"text"},{"text":"const","kind":"keyword"},{"text":" ","kind":"text"},{"text":"int","preciseIdentifier":"c:I","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"detectedObjectBoundingBox","kind":"internalParam"},{"text":", ","kind":"text"},{"text":"int","preciseIdentifier":"c:I","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"selectedBoundingBox","kind":"internalParam"},{"text":");","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"0 on success, or a non-zero error code on failure.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Analyzes the input image and identifies the most suitable 200x200 pixel","type":"text"},{"text":" ","type":"text"},{"text":"region (bounding box) with high level of details that intersects a given bounding box.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"detectedObjectBoundingBox","type":"codeVoice"},{"text":" is empty (width or height is 0), any region can be selected. Otherwise,","type":"text"},{"text":" ","type":"text"},{"text":"the selected region should have non-empty intersection with this bounding box. The selected region","type":"text"},{"text":" ","type":"text"},{"text":"should lie fully inside the input image.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If there is no region satisfying these conditions - if image width or height is smaller than 200","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"detectedObjectBoundingBox","type":"codeVoice"},{"text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200).","type":"text"}]},{"code":["                                  a bounding box in the format (x, y, width, height)."],"type":"codeListing","syntax":null},{"code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."],"type":"codeListing","syntax":null}],"kind":"content"}],"metadata":{"roleHeading":"Function","role":"symbol","fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}],"title":"samSelectDetailRegion","navigatorTitle":[{"kind":"identifier","text":"samSelectDetailRegion"}],"modules":[{"name":"DotFaceCore"}],"symbolKind":"func","externalID":"c:@F@samSelectDetailRegion"},"sections":[],"kind":"symbol","references":{"doc://DotFaceCore/documentation/DotFaceCore/samSelectDetailRegion":{"identifier":"doc:\/\/DotFaceCore\/documentation\/DotFaceCore\/samSelectDetailRegion","fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}],"title":"samSelectDetailRegion","url":"\/documentation\/dotfacecore\/samselectdetailregion","abstract":[],"kind":"symbol","role":"symbol","type":"topic"},"doc://DotFaceCore/documentation/DotFaceCore"