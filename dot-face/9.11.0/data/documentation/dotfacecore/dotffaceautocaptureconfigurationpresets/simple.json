DotFaceCore\/documentation\/DotFaceCore\/DOTFFaceAutoCaptureConfigurationPresets\/simple","role":"symbol","title":"simple","url":"\/documentation\/dotfacecore\/dotffaceautocaptureconfigurationpresets\/simple","abstract":[{"type":"text","text":"Configuration suitable for face verification use cases."},{"type":"text","text":" "},{"type":"text","text":"The component operates without any visual aids or guidance for the user, with the exception of the detection layer (tracking circle)."},{"type":"text","text":" "},{"type":"text","text":"There is no automatic triggering of the capture process."},{"type":"text","text":" "},{"type":"text","text":"Instead, the client is responsible for initiating the capture by explicitly calling the "},{"type":"text","text":"requestCapture"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"This configuration provides a minimalistic approach, offering flexibility to the client in managing the capture timing and user interaction,"},{"type":"text","text":" "},{"type":"text","text":"which is often desired in verification scenarios."}],"fragments":[{"kind":"identifier","text":"simple"}],"kind":"symbol","type":"topic"}}}