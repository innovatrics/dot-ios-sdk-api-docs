idth or height is 0), any region can be selected. Otherwise,","type":"text"},{"text":" ","type":"text"},{"text":"the selected region should have non-empty intersection with this bounding box. The selected region","type":"text"},{"text":" ","type":"text"},{"text":"should lie fully inside the input image.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If there is no region satisfying these conditions - if image width or height is smaller than 200","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"codeVoice","code":"detectedObjectBoundingBox"},{"text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200).","type":"text"}],"type":"paragraph"},{"code":["                                  a bounding box in the format (x, y, width, height)."],"syntax":null,"type":"codeListing"},{"code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."],"syntax":null,"type":"codeListing"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/DotDocument\/documentation\/DotDocument"]]},"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"DotDocument"}],"role":"symbol","navigatorTitle":[{"text":"samSelectDetailRegion","kind":"identifier"}],"externalID":"c:@F@samSelectDetailRegion","symbolKind":"func","title":"samSelectDetailRegion","roleHeading":"Function","fragments":[{"kind":"identifier","text":"samSelectDetailRegion"}]},"references":{"doc://DotDocument/documentation/DotDocument/sam_color_image":{"title":"sam_color_image","role":"symbol","abstract":[],"identifier":"doc:\/\/DotDocument\/documentation\/DotDocument\/sam_color_image","type":"topic","fragments":[{"kind":"identifier","text":"sam_color_image"}],"kind":"symbol","url":"\/documentation\/dotdocument\/sam_color_image"},"doc://DotDocument/documentation/DotDocument/samSelectDetailRegion":{"role"