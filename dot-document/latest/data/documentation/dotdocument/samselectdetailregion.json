rwise,"},{"type":"text","text":" "},{"type":"text","text":"the selected region should have non-empty intersection with this bounding box. The selected region"},{"type":"text","text":" "},{"type":"text","text":"should lie fully inside the input image."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If there is no region satisfying these conditions - if image width or height is smaller than 200"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"detectedObjectBoundingBox","type":"codeVoice"},{"type":"text","text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200)."}]},{"type":"codeListing","code":["                                  a bounding box in the format (x, y, width, height)."],"syntax":null},{"type":"codeListing","code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."],"syntax":null}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/DotDocument\/documentation\/DotDocument"]]},"metadata":{"roleHeading":"Function","symbolKind":"func","title":"samSelectDetailRegion","navigatorTitle":[{"text":"samSelectDetailRegion","kind":"identifier"}],"role":"symbol","modules":[{"name":"DotDocument"}],"externalID":"c:@F@samSelectDetailRegion","fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}]},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/dotdocument\/samselectdetailregion"]}],"references":{"doc://DotDocument/documentation/DotDocument/samSelectDetailRegion":{"fragments":[{"kind":"identifier","text":"samSelectDetailRegion"}],"url":"\/documentation\/dotdocument\/samselectdetailregion","abstract":[],"role":"symbol","kind":"symbol","identifier":"doc:\/\/DotDocument\/documentation\/DotDocument\/samSelectDetailRegion","type":"topic","title":"samSelectDetailRegion"},"doc://DotDocument/documentation/DotDocument/