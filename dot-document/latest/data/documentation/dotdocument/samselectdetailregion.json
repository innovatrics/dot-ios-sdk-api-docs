idth or height is 0), any region can be selected. Otherwise,"},{"type":"text","text":" "},{"type":"text","text":"the selected region should have non-empty intersection with this bounding box. The selected region"},{"type":"text","text":" "},{"type":"text","text":"should lie fully inside the input image."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If there is no region satisfying these conditions - if image width or height is smaller than 200"},{"type":"text","text":" "},{"text":"or ","type":"text"},{"type":"codeVoice","code":"detectedObjectBoundingBox"},{"text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200).","type":"text"}]},{"type":"codeListing","syntax":null,"code":["                                  a bounding box in the format (x, y, width, height)."]},{"type":"codeListing","syntax":null,"code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."]}]}],"metadata":{"symbolKind":"func","externalID":"c:@F@samSelectDetailRegion","modules":[{"name":"DotDocument"}],"role":"symbol","title":"samSelectDetailRegion","roleHeading":"Function","fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}],"navigatorTitle":[{"text":"samSelectDetailRegion","kind":"identifier"}]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/DotDocument\/documentation\/DotDocument\/samSelectDetailRegion"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://DotDocument/documentation/DotDocument/samSelectDetailRegion":{"url":"\/documentation\/dotdocument\/samselectdetailregion","type":"topic","kind":"symbol","abstract":[],"title":"samSelectDetailRegion","fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}],"identifier":"doc:\/\/DotDocument\/documentation\/DotDocument\/samSelectDetailRegion","role":"symbol"},"doc://DotDocument/documentation/DotDocument"