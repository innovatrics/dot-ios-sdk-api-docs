alling "},{"code":"read","type":"codeVoice"},{"type":"text","text":" again. An overlapping request"},{"type":"text","text":" "},{"type":"text","text":"reports a generic "},{"code":"ReadError","type":"codeVoice"},{"type":"text","text":" through the failure delegate, with an internal error describing"},{"type":"text","text":" "},{"type":"text","text":"that a reading operation is already in progress. It does not end the active operation,"},{"type":"text","text":" "},{"type":"text","text":"which still delivers its own terminal callback. There is no dedicated public error type"},{"type":"text","text":" "},{"type":"text","text":"for overlap rejection; applications should track whether they have an active read."}]}]}],"references":{"doc://DotNfc/documentation/DotNfc/NfcTravelDocumentReader/read(password:activeAuthenticationChallenge:)":{"url":"\/documentation\/dotnfc\/nfctraveldocumentreader\/read(password:activeauthenticationchallenge:)","kind":"symbol","title":"read(password:activeAuthenticationChallenge:)","type":"topic","identifier":"doc:\/\/DotNfc\/documentation\/DotNfc\/NfcTravelDocumentReader\/read(password:activeAuthenticationChallenge:)","role":"symbol","abstract":[{"type":"text","text":"Read passport using NFC password."}],"navigatorTitle":[{"text":"readWithPassword:activeAuthenticationChallenge:","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"read"},{"kind":"text","text":"("},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@DotNfc@objc(pl)DOTNTravelDocumentReaderPassword","text":"TravelDocumentReaderPassword"},{"kind":"text","text":", "},{"kind":"externalParam","text":"activeAuthenticationChallenge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV","text":"Data"},{"kind":"text","text":"?)"}]},"doc://DotNfc/documentation/DotNfc/TravelDocumentReaderPassword":{"role":"sym