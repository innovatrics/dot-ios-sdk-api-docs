{"hierarchy":{"paths":[["doc:\/\/DotFaceLite\/documentation\/DotFaceLite"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"roleHeading":"Function","navigatorTitle":[{"kind":"identifier","text":"samSelectDetailRegion"}],"modules":[{"name":"DotFaceLite"}],"externalID":"c:@F@samSelectDetailRegion","role":"symbol","title":"samSelectDetailRegion","fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}],"symbolKind":"func"},"variants":[{"paths":["\/documentation\/dotfacelite\/samselectdetailregion"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"identifier":{"url":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/samSelectDetailRegion","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"preciseIdentifier":"c:I","text":"int","kind":"typeIdentifier"},{"kind":"text","text":" "},{"kind":"identifier","text":"samSelectDetailRegion"},{"kind":"text","text":"("},{"kind":"keyword","text":"const"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/sam_color_image","text":"SamColorImage","preciseIdentifier":"c:@S@sam_color_image"},{"kind":"text","text":" * "},{"kind":"internalParam","text":"image"},{"kind":"text","text":", "},{"kind":"keyword","text":"const"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"int","preciseIdentifier":"c:I"},{"kind":"text","text":" * "},{"kind":"internalParam","text":"detectedObjectBoundingBox"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"int","preciseIdentifier":"c:I"},{"kind":"text","text":" * "},{"kind":"internalParam","text":"selectedBoundingBox"},{"kind":"text","text":");"}],"platforms":["iOS"],"languages":["occ"]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"0 on success, or a non-zero error code on failure."}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Analyzes the input image and identifies the most suitable 200x200 pixel"},{"type":"text","text":" "},{"type":"text","text":"region (bounding box) with high level of details that intersects a given bounding box."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"detectedObjectBoundingBox","type":"codeVoice"},{"type":"text","text":" is empty (width or height is 0), any region can be selected. Otherwise,"},{"type":"text","text":" "},{"type":"text","text":"the selected region should have non-empty intersection with this bounding box. The selected region"},{"type":"text","text":" "},{"type":"text","text":"should lie fully inside the input image."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If there is no region satisfying these conditions - if image width or height is smaller than 200"},{"type":"text","text":" "},{"type":"text","text":"or "},{"code":"detectedObjectBoundingBox","type":"codeVoice"},{"type":"text","text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200)."}]},{"type":"codeListing","syntax":null,"code":["                                  a bounding box in the format (x, y, width, height)."]},{"type":"codeListing","syntax":null,"code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."]}]}],"references":{"doc://DotFaceLite/documentation/DotFaceLite":{"kind":"symbol","role":"collection","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite","type":"topic","url":"\/documentation\/dotfacelite","title":"DotFaceLite","abstract":[{"type":"text","text":"version: 9.10.0"}]},"doc://DotFaceLite/documentation/DotFaceLite/sam_color_image":{"type":"topic","abstract":[],"title":"sam_color_image","kind":"symbol","role":"symb