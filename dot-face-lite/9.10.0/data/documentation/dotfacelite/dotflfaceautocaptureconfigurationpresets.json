,"type":"topic","url":"\/documentation\/dotfacelite","title":"DotFaceLite","abstract":[{"type":"text","text":"version: 9.10.0"}]},"doc://DotFaceLite/documentation/DotFaceLite/DOTFLFaceAutoCaptureConfigurationPresets/simple":{"type":"topic","abstract":[{"text":"Configuration suitable for face verification use cases.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The component operates without any visual aids or guidance for the user, with the exception of the detection layer (tracking circle)."},{"type":"text","text":" "},{"type":"text","text":"There is no automatic triggering of the capture process."},{"type":"text","text":" "},{"type":"text","text":"Instead, the client is responsible for initiating the capture by explicitly calling the "},{"type":"text","text":"requestCapture"},{"text":" method.","type":"text"},{"text":" ","type":"text"},{"text":"This configuration provides a minimalistic approach, offering flexibility to the client in managing the capture timing and user interaction,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which is often desired in verification scenarios."}],"title":"simple","kind":"symbol","role":"symbol","fragments":[{"kind":"identifier","text":"simple"}],"url":"\/documentation\/dotfacelite\/dotflfaceautocaptureconfigurationpresets\/simple","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets\/simple"},"doc://DotFaceLite/objc(cs)NSObject":{"identifier":"doc:\/\/DotFaceLite\/objc(cs)NSObject","type":"unresolvable","title":"NSObject"},"doc://DotFaceLite/documentation/DotFaceLite/DOTFLFaceAutoCaptureConfigurationPresets/init":{"title":"init","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets\/init","abstract":[],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"init"}],"type":"topic","url":"\/documentation\/dotfacelite\/dotflfaceautocaptureconfigurationpresets\/init","role":"symbol","fragm