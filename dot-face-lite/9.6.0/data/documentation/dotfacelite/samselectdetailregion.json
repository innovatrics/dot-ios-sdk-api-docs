:"text"},{"text":" ","type":"text"},{"text":"should lie fully inside the input image.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If there is no region satisfying these conditions - if image width or height is smaller than 200","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"detectedObjectBoundingBox","type":"codeVoice"},{"text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200).","type":"text"}]},{"type":"codeListing","code":["                                  a bounding box in the format (x, y, width, height)."],"syntax":null},{"type":"codeListing","code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."],"syntax":null}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/samSelectDetailRegion"},"sections":[],"hierarchy":{"paths":[["doc:\/\/DotFaceLite\/documentation\/DotFaceLite"]]},"metadata":{"modules":[{"name":"DotFaceLite"}],"navigatorTitle":[{"text":"samSelectDetailRegion","kind":"identifier"}],"symbolKind":"func","title":"samSelectDetailRegion","role":"symbol","externalID":"c:@F@samSelectDetailRegion","fragments":[{"kind":"identifier","text":"samSelectDetailRegion"}],"roleHeading":"Function"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/dotfacelite\/samselectdetailregion"]}],"references":{"doc://DotFaceLite/documentation/DotFaceLite":{"type":"topic","kind":"symbol","url":"\/documentation\/dotfacelite","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite","abstract":[{"type":"text","text":"version: 9.6.0"}],"role":"collection","title":"DotFaceLite"},"doc://DotFaceLite/documentation/DotFaceLite/sam_color_image":{"identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/sam_color_image","abs