n can be selected. Otherwise,"},{"text":" ","type":"text"},{"type":"text","text":"the selected region should have non-empty intersection with this bounding box. The selected region"},{"type":"text","text":" "},{"type":"text","text":"should lie fully inside the input image."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If there is no region satisfying these conditions - if image width or height is smaller than 200"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"detectedObjectBoundingBox"},{"text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200).","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["                                  a bounding box in the format (x, y, width, height)."]},{"syntax":null,"type":"codeListing","code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/dotfacelite\/samselectdetailregion"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"DotFaceLite"}],"fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}],"externalID":"c:@F@samSelectDetailRegion","role":"symbol","roleHeading":"Function","title":"samSelectDetailRegion","navigatorTitle":[{"text":"samSelectDetailRegion","kind":"identifier"}],"symbolKind":"func"},"references":{"doc://DotFaceLite/documentation/DotFaceLite/sam_color_image":{"role":"symbol","type":"topic","abstract":[],"url":"\/documentation\/dotfacelite\/sam_color_image","kind":"symbol","title":"sam_color_image","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/sam_color_image","fragments":[{"kind":"identifier","text":"sam_color_image"}]},"doc://DotFaceLite/documentation/DotFaceLite/samSelectDetailRegion":{"title