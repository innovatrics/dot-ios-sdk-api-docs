{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/DotFaceLite\/documentation\/DotFaceLite"]]},"identifier":{"url":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/samSelectDetailRegion","interfaceLanguage":"occ"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/dotfacelite\/samselectdetailregion"]}],"metadata":{"externalID":"c:@F@samSelectDetailRegion","symbolKind":"func","fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}],"title":"samSelectDetailRegion","roleHeading":"Function","modules":[{"name":"DotFaceLite"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"samSelectDetailRegion"}]},"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"typeIdentifier","text":"int","preciseIdentifier":"c:I"},{"text":" ","kind":"text"},{"kind":"identifier","text":"samSelectDetailRegion"},{"text":"(","kind":"text"},{"text":"const","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/sam_color_image","text":"SamColorImage","kind":"typeIdentifier","preciseIdentifier":"c:@S@sam_color_image"},{"kind":"text","text":" * "},{"text":"image","kind":"internalParam"},{"text":", ","kind":"text"},{"text":"const","kind":"keyword"},{"text":" ","kind":"text"},{"text":"int","preciseIdentifier":"c:I","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"detectedObjectBoundingBox","kind":"internalParam"},{"text":", ","kind":"text"},{"text":"int","preciseIdentifier":"c:I","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"selectedBoundingBox","kind":"internalParam"},{"text":");","kind":"text"}],"platforms":["iOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"0 on success, or a non-zero error code on failure.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Analyzes the input image and identifies the most suitable 200x200 pixel","type":"text"},{"text":" ","type":"text"},{"text":"region (bounding box) with high level of details that intersects a given bounding box.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"detectedObjectBoundingBox"},{"text":" is empty (width or height is 0), any region can be selected. Otherwise,","type":"text"},{"text":" ","type":"text"},{"text":"the selected region should have non-empty intersection with this bounding box. The selected region","type":"text"},{"text":" ","type":"text"},{"text":"should lie fully inside the input image.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If there is no region satisfying these conditions - if image width or height is smaller than 200","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"codeVoice","code":"detectedObjectBoundingBox"},{"text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200).","type":"text"}]},{"type":"codeListing","syntax":null,"code":["                                  a bounding box in the format (x, y, width, height)."]},{"syntax":null,"type":"codeListing","code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."]}]}],"references":{"doc://DotFaceLite/documentation/DotFaceLite":{"kind":"symbol","url":"\/documentation\/dotfacelite","role":"collection","type":"topic","abstract":[{"text":"version: 9.9.1","type":"text"}],"title":"DotFaceLite","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite"},"doc://DotFaceLite/documentation/DotFaceLite/sam_color_image":{"kind":"symbol","role":"symbol","fragments":[{"text":"sam_color_image","kind":"identifier"}],"type":"topic","url":"\/documentation\/dotfacelite\/sam_color_image","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/sam_color_image","title":"sam_color_image","abstract":[]},"doc://DotFaceLite/documentation/DotFaceLite/samSelectDetailRegion":{"kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/samSelectDetailRegion","fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}],"title":"samSelectDetailRegion","role":"symbol","url":"\/documentation\/dotfacelite\/samselectdetailregion"}}}