{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/samSelectDetailRegion","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"text":"int","preciseIdentifier":"c:I","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"samSelectDetailRegion","kind":"identifier"},{"text":"(","kind":"text"},{"text":"const","kind":"keyword"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"SamColorImage","preciseIdentifier":"c:@S@sam_color_image","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/sam_color_image"},{"text":" * ","kind":"text"},{"kind":"internalParam","text":"image"},{"kind":"text","text":", "},{"kind":"keyword","text":"const"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"c:I","text":"int"},{"text":" * ","kind":"text"},{"kind":"internalParam","text":"detectedObjectBoundingBox"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"int","preciseIdentifier":"c:I"},{"kind":"text","text":" * "},{"kind":"internalParam","text":"selectedBoundingBox"},{"kind":"text","text":");"}],"languages":["occ"]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"0 on success, or a non-zero error code on failure."}]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Analyzes the input image and identifies the most suitable 200x200 pixel","type":"text"},{"type":"text","text":" "},{"text":"region (bounding box) with high level of details that intersects a given bounding box.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"detectedObjectBoundingBox"},{"type":"text","text":" is empty (width or height is 0), any region can be selected. Otherwise,"},{"text":" ","type":"text"},{"type":"text","text":"the selected region should have non-empty intersection with this bounding box. The selected region"},{"type":"text","text":" "},{"text":"should lie fully inside the input image.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If there is no region satisfying these conditions - if image width or height is smaller than 200","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"detectedObjectBoundingBox","type":"codeVoice"},{"text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200).","type":"text"}]},{"syntax":null,"code":["                                  a bounding box in the format (x, y, width, height)."],"type":"codeListing"},{"syntax":null,"code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/DotFaceLite\/documentation\/DotFaceLite"]]},"metadata":{"role":"symbol","modules":[{"name":"DotFaceLite"}],"title":"samSelectDetailRegion","externalID":"c:@F@samSelectDetailRegion","navigatorTitle":[{"kind":"identifier","text":"samSelectDetailRegion"}],"symbolKind":"func","roleHeading":"Function","fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/dotfacelite\/samselectdetailregion"]}],"references":{"doc://DotFaceLite/documentation/DotFaceLite/sam_color_image":{"abstract":[],"kind":"symbol","fragments":[{"text":"sam_color_image","kind":"identifier"}],"role":"symbol","url":"\/documentation\/dotfacelite\/sam_color_image","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/sam_color_image","title":"sam_color_image","type":"topic"},"doc://DotFaceLite/documentation/DotFaceLite":{"type":"topic","identifier":