"},{"text":" is empty (width or height is 0), any region can be selected. Otherwise,","type":"text"},{"text":" ","type":"text"},{"text":"the selected region should have non-empty intersection with this bounding box. The selected region","type":"text"},{"text":" ","type":"text"},{"text":"should lie fully inside the input image.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If there is no region satisfying these conditions - if image width or height is smaller than 200","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"or "},{"type":"codeVoice","code":"detectedObjectBoundingBox"},{"text":" lies outside the image, the selected bounding box will be (0, 0, 200, 200).","type":"text"}]},{"code":["                                  a bounding box in the format (x, y, width, height)."],"syntax":null,"type":"codeListing"},{"syntax":null,"type":"codeListing","code":["                                  return, contains the bounding box in the format (x, y, width, height),","                                  where width and height are always set to 200."]}],"kind":"content"}],"sections":[],"metadata":{"navigatorTitle":[{"text":"samSelectDetailRegion","kind":"identifier"}],"role":"symbol","externalID":"c:@F@samSelectDetailRegion","modules":[{"name":"DotFaceLite"}],"fragments":[{"text":"samSelectDetailRegion","kind":"identifier"}],"roleHeading":"Function","title":"samSelectDetailRegion","symbolKind":"func"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/dotfacelite\/samselectdetailregion"]}],"references":{"doc://DotFaceLite/documentation/DotFaceLite":{"role":"collection","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite","type":"topic","title":"DotFaceLite","url":"\/documentation\/dotfacelite","kind":"symbol","abstract":[{"type":"text","text":"version: 9.10.0"}]},"doc://DotFaceLite/documentation/DotFaceLite/sam_color_image":{"fragments":[{"text":"sam_color_image","kind":"identifier"}],"type":"topic","url":"