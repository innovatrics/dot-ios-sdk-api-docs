istic approach, offering flexibility to the client in managing the capture timing and user interaction,","type":"text"},{"text":" ","type":"text"},{"text":"which is often desired in verification scenarios.","type":"text"}],"metadata":{"role":"symbol","modules":[{"name":"DotFaceLite"}],"symbolKind":"property","roleHeading":"Type Property","title":"simple","fragments":[{"kind":"identifier","text":"simple"}],"navigatorTitle":[{"text":"simple","kind":"identifier"}],"externalID":"c:@M@DotFaceLite@objc(cs)DOTFLFaceAutoCaptureConfigurationPresets(cpy)simple"},"references":{"doc://DotFaceLite/documentation/DotFaceLite/DOTFLFaceAutoCaptureConfiguration":{"title":"DOTFLFaceAutoCaptureConfiguration","type":"topic","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfiguration","abstract":[{"type":"text","text":"Configuration options for the UI Face Auto Capture component."}],"role":"symbol","kind":"symbol","url":"\/documentation\/dotfacelite\/dotflfaceautocaptureconfiguration","fragments":[{"text":"DOTFLFaceAutoCaptureConfiguration","kind":"identifier"}]},"doc://DotFaceLite/documentation/DotFaceLite":{"url":"\/documentation\/dotfacelite","role":"collection","type":"topic","title":"DotFaceLite","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite","abstract":[{"type":"text","text":"version: 9.6.0"}],"kind":"symbol"},"doc://DotFaceLite/documentation/DotFaceLite/DOTFLFaceAutoCaptureConfigurationPresets":{"title":"DOTFLFaceAutoCaptureConfigurationPresets","type":"topic","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets","abstract":[{"type":"text","text":"Pre-defined sets of configurations."}],"role":"symbol","kind":"symbol","url":"\/documentation\/dotfacelite\/dotflfaceautocaptureconfigurationpresets","fragments":[{"text":"DOTFLFaceAutoCaptureConfigurationPresets","kind":"identifier"}]},"doc://DotFaceLite/documentation/DotFaceLite/DOTFLFaceAutoCaptureConfigurationPresets/simple":{"url":"\/documentation\/dotfacelite\/dotflfaceautocaptureconfigurationpresets\/simple","role":"symbol","type":"topic","title":"simple","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets\/simple","fragments":[{"text":"simple","kind":"identifier"}],"abstract":[{"type":"text","text":"Configuration suitable for face verification use cases."},{"type":"text","text":" "},{"type":"text","text":"The component operates without any visual aids or guidance for the user, with the exception of the detection layer (tracking circle)."},{"type":"text","text":" "},{"type":"text","text":"There is no automatic triggering of the capture process."},{"type":"text","text":" "},{"type":"text","text":"Instead, the client is responsible for initiating the capture by explicitly calling the "},{"type":"text","text":"requestCapture"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"This configuration provides a minimalistic approach, offering flexibility to the client in managing the capture timing and user interaction,"},{"type":"text","text":" "},{"type":"text","text":"which is often desired in verification scenarios."}],"kind":"symbol"}}}