{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Configuration suitable for face verification use cases.","type":"text"},{"text":" ","type":"text"},{"text":"The component operates without any visual aids or guidance for the user, with the exception of the detection layer (tracking circle).","type":"text"},{"text":" ","type":"text"},{"text":"There is no automatic triggering of the capture process.","type":"text"},{"text":" ","type":"text"},{"text":"Instead, the client is responsible for initiating the capture by explicitly calling the ","type":"text"},{"text":"requestCapture","type":"text"},{"text":" method.","type":"text"},{"text":" ","type":"text"},{"text":"This configuration provides a minimalistic approach, offering flexibility to the client in managing the capture timing and user interaction,","type":"text"},{"text":" ","type":"text"},{"text":"which is often desired in verification scenarios.","type":"text"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets\/simple"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/DotFaceLite\/documentation\/DotFaceLite","doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS"],"tokens":[{"kind":"keyword","text":"@property"},{"text":" (","kind":"text"},{"kind":"keyword","text":"class"},{"kind":"text","text":", "},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"kind":"keyword","text":"strong"},{"text":", ","kind":"text"},{"text":"readonly","kind":"keyword"},{"text":") ","kind":"text"},{"identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfiguration","text":"DOTFLFaceAutoCaptureConfiguration","kind":"typeIdentifier","preciseIdentifier":"c:@M@DotFaceLite@objc(cs)DOTFLFaceAutoCaptureConfiguration"},{"kind":"text","text":" * "},{"text