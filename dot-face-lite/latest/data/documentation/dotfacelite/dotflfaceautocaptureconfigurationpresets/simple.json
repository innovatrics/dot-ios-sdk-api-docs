 automatic triggering of the capture process."},{"type":"text","text":" "},{"type":"text","text":"Instead, the client is responsible for initiating the capture by explicitly calling the "},{"type":"text","text":"requestCapture"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"This configuration provides a minimalistic approach, offering flexibility to the client in managing the capture timing and user interaction,"},{"type":"text","text":" "},{"type":"text","text":"which is often desired in verification scenarios."}],"references":{"doc://DotFaceLite/documentation/DotFaceLite/DOTFLFaceAutoCaptureConfiguration":{"abstract":[{"text":"Configuration options for the UI Face Auto Capture component.","type":"text"}],"title":"DOTFLFaceAutoCaptureConfiguration","type":"topic","fragments":[{"kind":"identifier","text":"DOTFLFaceAutoCaptureConfiguration"}],"role":"symbol","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfiguration","url":"\/documentation\/dotfacelite\/dotflfaceautocaptureconfiguration","kind":"symbol"},"doc://DotFaceLite/documentation/DotFaceLite":{"url":"\/documentation\/dotfacelite","abstract":[{"type":"text","text":"version: 9.6.0"}],"kind":"symbol","role":"collection","type":"topic","title":"DotFaceLite","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite"},"doc://DotFaceLite/documentation/DotFaceLite/DOTFLFaceAutoCaptureConfigurationPresets":{"identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets","title":"DOTFLFaceAutoCaptureConfigurationPresets","role":"symbol","kind":"symbol","url":"\/documentation\/dotfacelite\/dotflfaceautocaptureconfigurationpresets","abstract":[{"type":"text","text":"Pre-defined sets of configurations."}],"fragments":[{"kind":"identifier","text":"DOTFLFaceAutoCaptureConfigurationPresets"}],"type":"topic"},"doc://DotFaceLite/documentation/DotFaceLite/DOTFLFaceAutoCaptureConfigurationPresets/simple":{"iden