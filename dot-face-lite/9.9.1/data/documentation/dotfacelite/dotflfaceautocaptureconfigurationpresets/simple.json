{"abstract":[{"type":"text","text":"Configuration suitable for face verification use cases."},{"type":"text","text":" "},{"type":"text","text":"The component operates without any visual aids or guidance for the user, with the exception of the detection layer (tracking circle)."},{"type":"text","text":" "},{"type":"text","text":"There is no automatic triggering of the capture process."},{"type":"text","text":" "},{"type":"text","text":"Instead, the client is responsible for initiating the capture by explicitly calling the "},{"type":"text","text":"requestCapture"},{"type":"text","text":" method."},{"type":"text","text":" "},{"type":"text","text":"This configuration provides a minimalistic approach, offering flexibility to the client in managing the capture timing and user interaction,"},{"type":"text","text":" "},{"type":"text","text":"which is often desired in verification scenarios."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"simple"}],"title":"simple","role":"symbol","modules":[{"name":"DotFaceLite"}],"externalID":"c:@M@DotFaceLite@objc(cs)DOTFLFaceAutoCaptureConfigurationPresets(cpy)simple","symbolKind":"property","roleHeading":"Type Property","fragments":[{"text":"simple","kind":"identifier"}]},"identifier":{"url":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets\/simple","interfaceLanguage":"occ"},"sections":[],"hierarchy":{"paths":[["doc:\/\/DotFaceLite\/documentation\/DotFaceLite","doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/dotfacelite\/dotflfaceautocaptureconfigurationpresets\/simple"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"class","kind":"keyword"},{"text":", ","kind":"text"},{"