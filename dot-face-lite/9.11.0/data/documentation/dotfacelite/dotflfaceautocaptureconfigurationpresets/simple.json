{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Configuration suitable for face verification use cases.","type":"text"},{"text":" ","type":"text"},{"text":"The component operates without any visual aids or guidance for the user, with the exception of the detection layer (tracking circle).","type":"text"},{"text":" ","type":"text"},{"text":"There is no automatic triggering of the capture process.","type":"text"},{"text":" ","type":"text"},{"text":"Instead, the client is responsible for initiating the capture by explicitly calling the ","type":"text"},{"text":"requestCapture","type":"text"},{"text":" method.","type":"text"},{"text":" ","type":"text"},{"text":"This configuration provides a minimalistic approach, offering flexibility to the client in managing the capture timing and user interaction,","type":"text"},{"text":" ","type":"text"},{"text":"which is often desired in verification scenarios.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"class"},{"kind":"text","text":", "},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"strong"},{"kind":"text","text":", "},{"kind":"keyword","text":"readonly"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@DotFaceLite@objc(cs)DOTFLFaceAutoCaptureConfiguration","text":"DOTFLFaceAutoCaptureConfiguration","identifier":"doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfiguration"},{"kind":"text","text":" * "},{"kind":"identifier","text":"simple"},{"kind":"text","text":";"}],"platforms":["iOS"]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/DotFaceLite\/documentation\/DotFaceLite","doc:\/\/DotFaceLite\/documentation\/DotFaceLite\/DOTFLFaceAutoCaptureConfigurationPresets"]]},"kind":"symbol","metadata":{"modules":[{"name":"DotFaceLite"}],"roleHeading":"Type Pr